{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fairy-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fairy-invitations",
      // One-time setup: create the D1 database, then paste its id here.
      //   npx wrangler d1 create fairy-invitations
      // (DEPLOY.md walks through this step by step.)
      "database_id": "740850df-b064-4e4d-b39e-cbb5f5ff037c"
    }
  ]
}
